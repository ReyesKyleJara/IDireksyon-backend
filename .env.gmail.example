# Copy only these mail settings into your private .env after filling them in.
# Do not commit real credentials. Use a Google app password, not your login password.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD="your-google-app-password"
MAIL_FROM_ADDRESS=your-address@gmail.com
MAIL_FROM_NAME="IDireksyon"
MAIL_TIMEOUT=10
