        {
          "title": "Visit a National ID registration center",
          "type": "general",
          "blocks": [
            {
              "type": "text",
              "content": {
                "body": "Check the current PSA registration-center directory and proceed to an operational PSA, LGU, or mall-based center."
              }
            },
            {
              "type": "note",
              "content": {
                "body": "Confirm the site’s current services, hours, and walk-in or appointment arrangements before travelling. https://philsys.gov.ph/registration-center/"
              }
            }
          ]
        },
        {
          "title": "Present your supporting documents",
          "type": "general",
          "blocks": [
            {
              "type": "text",
              "content": {
                "body": "Present the originals of your accepted supporting documents to the Registration Kit Operator."
              }
            },
            {
              "type": "note",
              "content": {
                "body": "If details differ between your PSA birth certificate and the government ID presented, PSA states that the birth-certificate entries prevail."
              }
            }
          ]
        },
        {
          "title": "Validate your details and capture biometrics",
          "type": "general",
          "blocks": [
            {
              "type": "text",
              "content": {
                "body": "The operator validates your demographic details and captures applicable biometrics, including a front-facing photograph, fingerprints, and iris scans."
              }
            },
            {
              "type": "note",
              "content": {
                "body": "Biometric capture depends on age and applicable PSA rules. Ask the operator about children or applicants unable to provide a biometric."
              }
            }
          ]
        },
        {
          "title": "Review and confirm your information",
          "type": "general",
          "blocks": [
            {
              "type": "text",
              "content": {
                "body": "Carefully review your encoded demographic and biometric information before confirming it."
              }
            },
            {
              "type": "warning",
              "content": {
                "body": "Report spelling errors or incorrect details to the operator before completing registration."
              }
            }
          ]
        },
        {
          "title": "Keep your transaction slip",
          "type": "general",
          "blocks": [
            {
              "type": "text",
              "content": {
                "body": "Collect the transaction slip containing your Transaction Reference Number (TRN)."
              }
            },
            {
              "type": "note",
              "content": {
                "body": "Keep the slip for delivery tracking and checking availability of the National ID in paper format. Ask PSA about current delivery or claiming arrangements."
              }
            }
          ]
        }
      ]
    },
