              "content": {
                "body": "Required Documents"
              }
            },
            {
              "type": "checklist",
              "content": {
                "items": [
                  {
                    "body": "PSA-issued Certificate of Live Birth AND a government-issued ID with full name, front-facing photo, and signature/thumbmark"
