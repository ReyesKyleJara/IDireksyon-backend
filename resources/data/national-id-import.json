          "type": "general",
          "blocks": [
            {
              "type": "text",
              "content": {
                "body": "Follow the official service prompts and enter your demographic information as registered with PSA."
              }
            },
            {
              "type": "warning",
              "content": {
                "body": "Your TRN is not seeded as a mandatory digital-access credential; PSA’s published digital-access guidance specifies demographic information and facial verification."
