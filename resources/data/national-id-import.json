  "basic": {
    "name": "Philippine Identification System (PhilSys National ID)",
    "level": "National",
    "purpose": "Serves as a single, foundational government-issued proof of identity to simplify public and private transactions, promote financial inclusion, and streamline access to social protection services.",
    "description": "Foundational government-issued proof of identity available as a physical National ID card, National ID in paper format, and Digital National ID. The formats use a QR code for authentication; biometric data is collected during registration.",
    "eligibility": "Filipino citizens and eligible resident aliens. The revised IRR requires resident aliens to present ACR/ACR ID and a sworn certification of more than 180 aggregated days in the Philippines in the year before application.",
    "official_link": "https://philsys.gov.ph/",
    "prerequisite_notes": "Accepted documents are alternative routes. The birth-certificate primary route requires a qualifying government-issued ID as well. Custom requirement names are not inventory dependency links.",
    "processing_time": "Digital and paper-format availability and physical-card delivery vary. Check with PSA; no guaranteed instant generation or delivery deadline is encoded.",
    "validity": "Confirm applicant-specific validity and biometric updating rules with PSA. The supplied lifetime/one-year claims are retained in the source archive pending targeted review."
  },
  "fees": [
    {
      "label": "First-time National ID registration",
      "type": "free",
      "currency": "PHP",
      "notes": "PSA states registration is free of charge."
    },
    {
      "label": "National ID in paper format",
      "type": "free",
      "currency": "PHP",
      "notes": "PSA states claiming the paper-format National ID is free of charge."
    },
    {
      "label": "Demographic updating service",
      "type": "free",
      "currency": "PHP",
      "notes": "PSA states demographic updating at selected centers is free of charge."
    }
  ],
  "sources": [
